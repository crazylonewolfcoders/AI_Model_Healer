<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.crazy.lonewolf.coders</groupId>
        <artifactId>omnij-group</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>omnij-sample-app</artifactId>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <build>
<plugins>
    <plugin>
        <groupId>io.github.crazy.lonewolf.coders</groupId>
        <artifactId>omnij-plugin</artifactId>
        <version>1.0.0</version>
        <configuration>
        <!-- Pass custom properties directly into Mojo parameters -->
        <metaDataLocation>${project.build.directory}\classes\META-INF\omnij\</metaDataLocation>
        <basePackagesLocation>io.github.crazy.lonewolf.coders.model</basePackagesLocation>
    </configuration>
        <executions>
            <execution>
                <!-- Bind to a specific Maven lifecycle phase -->
                <phase>process-classes</phase>
                <goals>
                    <!-- Run the specific goal defined in your Mojo class -->
                    <goal>omnij</goal>
                </goals>

            </execution>
        </executions>
    </plugin>
</plugins>
    </build>
<dependencies>
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot</artifactId>
    </dependency>
    <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
        <groupId>io.github.crazy.lonewolf.coders</groupId>
        <artifactId>omnij-plugin</artifactId>
        <version>1.0.0</version>
    </dependency>

    <dependency>
        <groupId>io.github.crazy.lonewolf.coders</groupId>
        <artifactId>omnij-utils</artifactId>
        <version>1.0.0</version>
    </dependency>

    <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <optional>true</optional>
    </dependency>



    <dependency>
        <groupId>org.springframework.kafka</groupId>
        <artifactId>spring-kafka</artifactId>
    </dependency>

</dependencies>
</project>